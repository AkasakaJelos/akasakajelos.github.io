{
  "name": "mizuki",
  "type": "module",
  "version": "9.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro build --force && node scripts/check-global-style-loading.mjs && pagefind --site dist && node scripts/check-font-loading.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/markdown-enhancements.test.mjs tests/layout-regressions.test.mjs tests/image-loading.test.mjs tests/music-player-loading.test.mjs tests/covers.test.mjs tests/site-csp.test.mjs && node tests/crypto.test.mjs && node --test tools/verify-csp.test.cjs",
    "prepare-fonts": "node scripts/prepare-fonts.mjs",
    "check-fonts": "node scripts/check-font-loading.mjs",
    "prepare-images": "node scripts/prepare-default-images.mjs",
    "new-post": "node scripts/new-post.js",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "verify": "node tools/verify-csp.cjs dist --site-wide",
    "test:dist": "node --test tests/dist-urls.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "9.0.1",
    "@expressive-code/core": "^0.44.1",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@fancyapps/ui": "^6.1.14",
    "@iconify/svelte": "^5.2.2",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.4",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.1.5",
    "dayjs": "^1.11.21",
    "ec-lang-logo": "^1.0.5",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hastscript": "^9.0.1",
    "katex": "0.18.10",
    "marked": "^18.0.7",
    "node-html-parser": "^8.0.4",
    "overlayscrollbars": "^2.16.0",
    "pagefind": "^1.5.2",
    "pako": "^3.0.1",
    "qrcode": "^1.5.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-code-group": "^0.3.1",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-directive-rehype": "^1.0.0",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "stylus": "^0.64.0",
    "svelte": "^5.56.7",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.5.7",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.10",
    "@biomejs/biome": "^2.5.5",
    "@iconify-json/fa7-brands": "^1.2.4",
    "@iconify-json/fa7-regular": "^1.2.3",
    "@iconify-json/fa7-solid": "^1.2.5",
    "@iconify-json/material-symbols": "^1.2.86",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.91",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/pako": "^2.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "fast-xml-parser": "5.10.1",
    "fonteditor-core": "^2.6.3",
    "glob": "^13.0.6",
    "hast-util-from-html": "2.0.3",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^14.0.0"
  },
  "packageManager": "pnpm@11.5.3"
}
